# ==============================================================================
# SALES AI MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER COMMIT PRODUCTION CREDENTIALS OR REAL SECRETS TO REPOSITORY.
# All values below are illustrative templates and local development defaults.

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (Authoritative Truth with RLS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_in_prod
POSTGRES_SSLMODE=prefer
# The API must connect as the least-privileged, RLS-enforced role (never the postgres superuser:
# superusers bypass Row-Level Security). Startup refuses superuser/BYPASSRLS roles outside development.
DATABASE_URL=postgresql+psycopg://sales_app_user:<app_role_password>@localhost:5432/sales_ai_db

# Redis (Ephemeral Cache, Rate Limiting, Short-lived Locks only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO - Encrypted Documents, Audio Recordings)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_dev_access_key
S3_SECRET_KEY=minio_dev_secret_key
S3_BUCKET_DOCUMENTS=sales-ai-documents
S3_BUCKET_RECORDINGS=sales-ai-recordings
S3_REGION=us-east-1

# Identity & Authentication (OIDC / Keycloak / JWT)
JWT_SECRET_KEY=dev_jwt_secret_key_minimum_32_characters_random_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OIDC_ISSUER_URL=http://localhost:8080/realms/sales-ai
OIDC_CLIENT_ID=sales-ai-backend
OIDC_CLIENT_SECRET=dev_oidc_client_secret_change_in_prod

# Temporal Workflow Engine (Durable Business Orchestration)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sales-ai-main-queue

# AI Model Gateway & Inference Mode (local, cloud, hybrid)
INFERENCE_MODE=local
OLLAMA_BASE_URL=http://localhost:11434

# Hardware & Memory Guardrails (Laptop Envelope: 8GB VRAM / 16GB RAM)
MAX_GPU_VRAM_MB=7000
MAX_SYSTEM_RAM_MB=13500

# Local AI Models Stack
PRIMARY_LLM=qwen3.5:4b
REASONING_LLM=qwen3.5:9b-q4_K_M
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen3-Reranker-0.6B
ASR_MODEL=faster-whisper-small-int8
DARIJA_ASR_CANDIDATE=atlasia/moulsot.v0.3
TTS_FR_EN=Piper-fr_FR/en_US
TTS_AR=Piper-ar_JO
DARIJA_LID=atlasia/DarijaLID
ARABIZI_MODEL=atlasia/Transliteration-Moroccan-Darija

# Model Device Allocations (Preserve GPU strictly for active LLM)
PRIMARY_LLM_DEVICE=cuda
REASONING_LLM_DEVICE=cuda
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
ASR_DEVICE=cpu
TTS_DEVICE=cpu

# Optional Cloud Providers (For hybrid / cloud deployment)
GEMINI_API_KEY=dev_placeholder_gemini_api_key
OPENAI_API_KEY=dev_placeholder_openai_api_key
ANTHROPIC_API_KEY=dev_placeholder_anthropic_api_key

# Omnichannel & Telephony
WHATSAPP_API_TOKEN=dev_placeholder_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=dev_placeholder_phone_id
WHATSAPP_VERIFY_TOKEN=dev_placeholder_verify_token
TWILIO_ACCOUNT_SID=dev_placeholder_twilio_sid
TWILIO_AUTH_TOKEN=dev_placeholder_twilio_auth_token
SIP_TRUNK_HOST=sip.dev.internal
SIP_TRUNK_PORT=5060

# Peripheral Automation (n8n - strictly non-authoritative)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
N8N_API_KEY=dev_placeholder_n8n_key
N8N_WEBHOOK_SECRET=<generate_random_32+_chars>

# Payments: per-tenant provider webhook secrets live in tenant_channel_integrations
# (channel_type PAYMENT_<PROVIDER>). This shared value is a DEVELOPMENT-ONLY fallback.
PAYMENT_WEBHOOK_SECRET=<development_only_placeholder>
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Signs customer voice session tokens (tenant+session binding). Required outside development.
VOICE_SESSION_SECRET=<generate_random_32+_chars>
VOICE_SESSION_TOKEN_TTL_SECONDS=3600

# Preload the primary LLM at API startup (measured cold start ~15 s for qwen3.5:4b).
AI_WARMUP_ON_STARTUP=true

# Any secret left at its committed default makes startup fail when ENVIRONMENT is not development.

# Security & Redaction
DATA_RETENTION_DAYS_AUDIO=90
DATA_RETENTION_DAYS_TRANSCRIPTS=365
PII_REDACTION_ENABLED=true
ENFORCE_MFA_FOR_MANAGERS=true

# Local speech engines (F-15): faster-whisper (CPU, int8) and Piper voices (download outside the repo:
#   python -m piper.download_voices fr_FR-siwis-medium en_US-lessac-medium ar_JO-kareem-medium)
STT_MODEL_SIZE=small
STT_COMPUTE_TYPE=int8
# PIPER_VOICES_DIR=<defaults to %LOCALAPPDATA%/sales-ai/piper-voices>
