# ==============================================================================
# SALES AI MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER COMMIT PRODUCTION CREDENTIALS OR REAL SECRETS TO REPOSITORY.
# All values below are illustrative templates and local development defaults.

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (Authoritative Truth with RLS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_in_prod
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password_change_in_prod@localhost:5432/sales_ai_db

# Redis (Ephemeral Cache, Rate Limiting, Short-lived Locks only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO - Encrypted Documents, Audio Recordings)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_dev_access_key
S3_SECRET_KEY=minio_dev_secret_key
S3_BUCKET_DOCUMENTS=sales-ai-documents
S3_BUCKET_RECORDINGS=sales-ai-recordings
S3_REGION=us-east-1

# Identity & Authentication (OIDC / Keycloak / JWT)
JWT_SECRET_KEY=dev_jwt_secret_key_minimum_32_characters_random_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OIDC_ISSUER_URL=http://localhost:8080/realms/sales-ai
OIDC_CLIENT_ID=sales-ai-backend
OIDC_CLIENT_SECRET=dev_oidc_client_secret_change_in_prod

# Temporal Workflow Engine (Durable Business Orchestration)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sales-ai-main-queue

# AI Model Gateway & Providers
MODEL_GATEWAY_DEFAULT_MODEL=gemini-1.5-pro
GEMINI_API_KEY=dev_placeholder_gemini_api_key
OPENAI_API_KEY=dev_placeholder_openai_api_key
ANTHROPIC_API_KEY=dev_placeholder_anthropic_api_key

# Omnichannel & Telephony
WHATSAPP_API_TOKEN=dev_placeholder_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=dev_placeholder_phone_id
WHATSAPP_VERIFY_TOKEN=dev_placeholder_verify_token
TWILIO_ACCOUNT_SID=dev_placeholder_twilio_sid
TWILIO_AUTH_TOKEN=dev_placeholder_twilio_auth_token
SIP_TRUNK_HOST=sip.dev.internal
SIP_TRUNK_PORT=5060

# Peripheral Automation (n8n - strictly non-authoritative)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
N8N_API_KEY=dev_placeholder_n8n_key

# Security & Redaction
DATA_RETENTION_DAYS_AUDIO=90
DATA_RETENTION_DAYS_TRANSCRIPTS=365
PII_REDACTION_ENABLED=true
ENFORCE_MFA_FOR_MANAGERS=true
